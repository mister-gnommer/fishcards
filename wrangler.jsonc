{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "fishcards",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "fishcards.gnommer.pl", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fishcards",
			// Placeholder until `wrangler d1 create fishcards --update-config` writes the real id.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	]
}
