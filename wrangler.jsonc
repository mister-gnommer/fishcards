{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "fishcards",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	// Local mode would otherwise rewrite Host/Origin to the route's domain, which Better Auth rejects as a foreign origin.
	"dev": { "host": "localhost:8787" },
	"vars": {
		"BETTER_AUTH_URL": "https://fishcards.gnommer.pl"
	},
	"routes": [
		{ "pattern": "fishcards.gnommer.pl", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fishcards-db",
			"database_id": "9767182e-4b5d-4dd6-9c57-85b4833dce09",
			"migrations_dir": "drizzle"
		}
	]
}
